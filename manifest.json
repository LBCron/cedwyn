    "path": "/dartboard/api/v1/feed.xml",
    "format": "atom",
    "description": "Atom 1.0 feed"
   },
   {
    "path": "/dartboard/api/v1/rss.xml",
    "format": "rss",
    "description": "RSS 2.0 feed"
   },
   {
    "path": "/dartboard/api/v1/data.xml",
    "format": "xml",

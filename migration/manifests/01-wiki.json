{
 "schema": "cedwyn-webapp/1.0.0",
 "id": "wiki",
 "uid": "APP-01",
 "slot": {
  "n": 1,
  "of": 59,
  "label": "1 of 59"
 },
 "status": "live",
 "section": "Wales",
 "sections_shown": [
  "Wales",
  "Argentina"
 ],
 "group": "artifacts",
 "title": {
  "en": "Legal Wiki & Evidence",
  "cy": "Y Wici Cyfreithiol",
  "es": "La Wiki Legal"
 },
 "description": "Legal Wiki, evidence catalogue and searchable nomenclature register: source-linked names with dates, provenance, evidence status and limitations; dictionary/glossary remains a separate reference view.",
 "path": "/wiki/",
 "aliases": [
  "/nomenclature/",
  "/records/"
 ],
 "legacy_hosts": [
  "greathousefarmwiki.wordpress.com",
  "wiki.bucklerfamily.estate"
 ],
 "branch": {
  "name": "section/wiki",
  "exists": true,
  "standard_name": "webapp/wiki",
  "source_dir": "site",
  "other_branches": [
   "wiki"
  ]
 },
 "front_end": {
  "kind": "wordpress_mirror",
  "hosting": "cloudflare_pages",
  "project": "cedwyn (cedwyn-274.pages.dev, production branch site)",
  "build": "build-cedwyn (GitHub Actions) writes branch site",
  "worker_on_read": false,
  "notes": "apex bucklerfamily.estate reads run the router Worker until the static-first cutover (PR #157)"
 },
 "header": {
  "contract": "cedwyn-header/1",
  "nav_source": "/areas.json#nav",
  "prev_next": true,
  "label_format": "{n} of 59",
  "languages": [
   "en",
   "cy",
   "es"
  ],
  "scripts": [
   "/_cedwyn/runtime.js",
   "/_cedwyn/ghf/ghf-boot.js"
  ],
  "status": "legacy"
 },
 "data": {
  "slice": "evidence",
  "query": {
   "kinds": [
    "evidence",
    "artifact",
    "place",
    "person_or_body"
   ],
   "uid_prefixes": [
    "EV",
    "AR",
    "PL",
    "PE"
   ],
   "tags": [],
   "where": "public = true; stakeholder pages join correspondence by institution",
   "public_only": true
  },
  "registers": [
   "data/nomenclature.json",
   "data/glossary.json",
   "data/evidence-grades.json"
  ],
  "catalogue_status": "partly"
 },
 "local_store": {
  "static": [
   "/wiki/_data/evidence.json",
   "/wiki/api/v1/index.json"
  ],
  "client_cache": {
   "enabled": true,
   "store": "indexeddb",
   "strategy": "stale-while-revalidate",
   "max_age_s": 3600,
   "revalidate_with": "/wiki/api/v1/index.json rev",
   "pull_from": "/catalogue-db/ static export (never a Worker)"
  }
 },
 "api": {
  "base": "/wiki/api/v1/",
  "outputs": [
   {
    "path": "/wiki/api/v1/index.json",
    "format": "json",
    "description": "list + counts + rev + generated_at"
   },
   {
    "path": "/wiki/api/v1/items/{uid}.json",
    "format": "json",
    "description": "one record in this app's presentation, keyed by catalogue UID"
   },
   {
    "path": "/wiki/api/v1/feed.json",
    "format": "jsonfeed",
    "description": "JSON Feed 1.1, newest first"
   },
   {
    "path": "/wiki/api/v1/feed.xml",
    "format": "atom",
    "description": "Atom 1.0 feed"
   },
   {
    "path": "/wiki/api/v1/rss.xml",
    "format": "rss",
    "description": "RSS 2.0 feed"
   },
   {
    "path": "/wiki/api/v1/data.xml",
    "format": "xml",
    "description": "the whole slice as XML"
   }
  ],
  "cors": "*",
  "cache_control": "public, max-age=300",
  "listed_in": "/api/index.json"
 },
 "consumes": [
  {
   "app": "wayback",
   "path": "/wayback/api/v1/index.json",
   "why": "source copies"
  },
  {
   "app": "email",
   "path": "/email/api/v1/by-institution/",
   "why": "stakeholder correspondence"
  },
  {
   "app": "forensic",
   "path": "/forensic/api/v1/index.json",
   "why": "assessment per stakeholder"
  }
 ],
 "consumed_by": [
  "chat"
 ],
 "external_sources": [
  {
   "name": "WordPress greathousefarmwiki",
   "adapter": "tools/wiki.py (public REST mirror)",
   "cadence": "daily",
   "auth": "none",
   "writes": "/wiki/_data/wp-pages.json"
  }
 ],
 "dynamic_endpoints": [],
 "migration": {
  "phase": "branch",
  "phases_done": [
   "inventory",
   "manifest",
   "branch"
  ],
  "rag": "amber",
  "next_action": "write the slice entry in data/core/slices.json and generate /wiki/api/v1/",
  "blockers": [
   "data not (fully) in the central catalogue: registers listed under data.registers fold in with the owner's approval"
  ],
  "prs": [],
  "pilot": false
 },
 "owner": "Cedwyn editors (owner approval for catalogue changes)",
 "version": "0.1.0",
 "changelog": [
  {
   "version": "0.1.0",
   "date": "2026-11-03",
   "summary": "Manifest created from the live tour inventory (/areas.json nav), themes.json, data/site-areas.json and data/halves.json 1.4.0."
  }
 ],
 "sources": [
  "/areas.json nav (cedwyn-274.pages.dev, read 2026-11-03)",
  "themes.json@main",
  "data/site-areas.json@main",
  "data/halves.json@PR#154 (1.4.0)",
  "cedwyn branch list (git ls-remote)"
 ]
}
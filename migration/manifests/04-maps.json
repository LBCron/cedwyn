   "/_cedwyn/ghf/ghf-boot.js"
  ],
  "status": "legacy"
 },
 "data": {
  "slice": "places",
  "query": {
   "kinds": [
    "place",
    "evidence"
   ],
   "uid_prefixes": [
    "PL",
    "EV"
   ],
   "tags": [],
   "where": "records with places[] or coordinates",
   "public_only": true
  },
  "registers": [
   "data/spatial/",
   "data/parcel-stories.json"
  ],
  "catalogue_status": "partly"
 },
 "local_store": {
  "static": [
   "/maps/_data/places.json",
   "/maps/api/v1/index.json"
  ],
  "client_cache": {
   "enabled": true,
   "store": "indexeddb",
   "strategy": "stale-while-revalidate",
   "max_age_s": 3600,
   "revalidate_with": "/maps/api/v1/index.json rev",
   "pull_from": "/catalogue-db/ static export (never a Worker)"
  }
 },
 "api": {
  "base": "/maps/api/v1/",
  "outputs": [
   {
    "path": "/maps/api/v1/index.json",
    "format": "json",
    "description": "list + counts + rev + generated_at"
   },
   {
    "path": "/maps/api/v1/items/{uid}.json",
    "format": "json",
    "description": "one record in this app's presentation, keyed by catalogue UID"
   },
   {
    "path": "/maps/api/v1/feed.json",
    "format": "jsonfeed",
    "description": "JSON Feed 1.1, newest first"
   },
   {
    "path": "/maps/api/v1/feed.xml",
    "format": "atom",
    "description": "Atom 1.0 feed"
   },
   {
    "path": "/maps/api/v1/rss.xml",
    "format": "rss",
    "description": "RSS 2.0 feed"
   },
   {
    "path": "/maps/api/v1/data.xml",
    "format": "xml",
    "description": "the whole slice as XML"
   }
  ],
  "cors": "*",
  "cache_control": "public, max-age=300",
  "listed_in": "/api/index.json"
 },
 "consumes": [
  {
   "app": "infographic",
   "path": "/infographic/api/v1/index.json",
   "why": "parcel chains per parcel"
  }
 ],
 "consumed_by": [
  "infographic",
  "arcade",
  "wales"
 ],

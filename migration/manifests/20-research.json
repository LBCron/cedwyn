 ],
 "group": "research",
 "title": {
  "en": "Research Library",
  "cy": "Y Llyfrgell Ymchwil",
  "es": "La Biblioteca de Investigación"
 },
 "description": "Evidence pages and analytical work.",
 "path": "/research/",
 "aliases": [],
 "legacy_hosts": [
  "research.bucklerfamily.estate"
 ],
 "branch": {
  "name": "section/research",
  "exists": true,
  "standard_name": "webapp/research",
  "source_dir": null,
  "other_branches": [
   "research"
  ]
 },
 "front_end": {
  "kind": "static",
  "hosting": "cloudflare_pages",
  "project": "cedwyn (cedwyn-274.pages.dev, production branch site)",
  "build": "build-cedwyn (GitHub Actions) writes branch site",
  "worker_on_read": true,
  "notes": "apex bucklerfamily.estate reads run the router Worker until the static-first cutover (PR #157)"
 },
 "header": {
  "contract": "cedwyn-header/1",
  "nav_source": "/areas.json#nav",
  "prev_next": true,
  "label_format": "{n} of 59",
  "languages": [
   "en",
   "cy",
   "es"
  ],
  "scripts": [
   "/_cedwyn/runtime.js",
   "/_cedwyn/ghf/ghf-boot.js"
  ],
  "status": "legacy"
 },
 "data": {
  "slice": "evidence",
  "query": {
   "kinds": [
    "evidence",
    "missing_record",
    "observation",
    "catalogue_candidate"
   ],
   "uid_prefixes": [
    "EV",
    "MR",
    "OBS",
    "CC"
   ],
   "tags": [],
   "where": "public research records",
   "public_only": true
  },
  "registers": [
   "section/research (evidence/, artifacts/, missing-records/, books/findings.csv)",
   "data/observations.json"
  ],
  "catalogue_status": "partly"
 },
 "local_store": {
  "static": [
   "/research/_data/evidence.json",
   "/research/api/v1/index.json"
  ],
  "client_cache": {
   "enabled": true,
   "store": "indexeddb",
   "strategy": "stale-while-revalidate",
   "max_age_s": 3600,
   "revalidate_with": "/research/api/v1/index.json rev",
   "pull_from": "/catalogue-db/ static export (never a Worker)"
  }
 },
 "api": {
  "base": "/research/api/v1/",
  "outputs": [
   {
    "path": "/research/api/v1/index.json",
    "format": "json",
    "description": "list + counts + rev + generated_at"
   },
   {
    "path": "/research/api/v1/items/{uid}.json",
    "format": "json",
    "description": "one record in this app's presentation, keyed by catalogue UID"
   },
   {
    "path": "/research/api/v1/feed.json",
    "format": "jsonfeed",
    "description": "JSON Feed 1.1, newest first"
   },
   {
    "path": "/research/api/v1/feed.xml",
    "format": "atom",
    "description": "Atom 1.0 feed"
   },
   {
    "path": "/research/api/v1/rss.xml",
    "format": "rss",
    "description": "RSS 2.0 feed"
   },
   {
    "path": "/research/api/v1/data.xml",
    "format": "xml",
    "description": "the whole slice as XML"
   }
  ],
  "cors": "*",
  "cache_control": "public, max-age=300",
  "listed_in": "/api/index.json"
 },
 "consumes": [
  {
   "app": "wayback",
   "path": "/wayback/api/v1/index.json",
   "why": "source copies"
  }
 ],
 "consumed_by": [],
 "external_sources": [
  {
   "name": "Book flywheel",
   "adapter": "work/book-flywheel CSV export",
   "cadence": "3-hourly",
   "auth": "none",
   "writes": "/research/_data/books.json"
  }
 ],
 "dynamic_endpoints": [
  {
   "path": "research.bucklerfamily.estate/*",
   "worker": "research-wp",
   "why": "legacy host proxy (to retire)"
  },
  {
   "path": "research.bucklerfamily.estate/api/*",
   "worker": "research-wiki-mcp",
   "why": "agent MCP"
  }
 ],
 "migration": {
  "phase": "branch",
  "phases_done": [
   "inventory",
   "manifest",
   "branch"
  ],
  "rag": "amber",
  "next_action": "write the slice entry in data/core/slices.json and generate /research/api/v1/",
  "blockers": [
   "a Worker runs on page reads today (route on the cedwyn host); the static-first cutover and this app's static rewrite remove it",
   "data not (fully) in the central catalogue: registers listed under data.registers fold in with the owner's approval"
  ],
  "prs": [],
  "pilot": false
 },
 "owner": "Cedwyn editors (owner approval for catalogue changes)",
 "version": "0.1.0",
 "changelog": [

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cedwyn.bucklerfamily.estate/_cedwyn/standard/webapp.schema.json",
 "title": "Cedwyn webapp manifest (standard)",
 "version": "1.0.0",
 "description": "One manifest per tour slot (1-59). Every Cedwyn webapp is a static front end with the common header, a data slice drawn from the central catalogue by catalogue UID, a local static store with an optional client-side cache, and a static API (JSON, RSS/Atom, XML) that other webapps read. Reads never run a Worker; only the listed dynamic endpoints do. Supersedes the draft app-manifest.schema.json on branch codex/cedwyn-migration-plan-20261028 (its fields map: app_id->id, canonical_path->path, source_branch->branch.name, version, change_log->changelog).",
 "type": "object",
 "required": [
  "schema",
  "id",
  "uid",
  "slot",
  "status",
  "section",
  "title",
  "path",
  "branch",
  "front_end",
  "header",
  "data",
  "local_store",
  "api",
  "consumes",
  "external_sources",
  "dynamic_endpoints",
  "migration",
  "owner",
  "version",
  "changelog"
 ],
 "additionalProperties": false,
 "$defs": {
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "semver": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "path": {
   "type": "string",
   "pattern": "^/([a-z0-9]+(?:-[a-z0-9]+)*/)*$"
  },
  "i18n": {
   "type": "object",
   "required": [
    "en"
   ],
   "properties": {
    "en": {
     "type": "string",
     "minLength": 1
    },
    "cy": {
     "type": "string"
    },
    "es": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "endpoint": {
   "type": "object",
   "required": [
    "app",
    "path"
   ],
   "properties": {
    "app": {
     "$ref": "#/$defs/slug"
    },
    "path": {
     "type": "string",
     "pattern": "^/"
    },
    "why": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "phase": {
   "enum": [
    "inventory",
    "manifest",
    "branch",
    "static_front_end",
    "data_slice",
    "api",
    "header",
    "live_verified"
   ]
  }
 },
 "properties": {
  "schema": {
   "const": "cedwyn-webapp/1.0.0"
  },
  "id": {
   "$ref": "#/$defs/slug",
   "description": "Webapp slug; also its flat address /<id>/ and its API folder."
  },
  "uid": {
   "type": "string",
   "pattern": "^APP-(0[1-9]|[1-5][0-9])$",
   "description": "Catalogue UID of the webapp itself: APP-<slot, 2 digits>. Kept stable if the app moves slot (then aliases records the old one)."
  },
  "slot": {
   "type": "object",
   "required": [
    "n",
    "of"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 1,
     "maximum": 59
    },
    "of": {
     "const": 59
    },
    "label": {
     "type": "string",
     "description": "Header label, e.g. '3 of 59'."
    }
   },
   "additionalProperties": false
  },
  "status": {
   "enum": [
    "live",
    "pending_pr",
    "vacant"
   ],
   "description": "live = in /areas.json nav today; pending_pr = an open PR assigns the slot; vacant = no webapp holds the slot (candidate below is a proposal, not content)."
  },
  "vacant": {
   "type": "object",
   "description": "Only for status vacant/pending_pr: the proposed occupant (an existing page, branch or PR — never new content).",
   "required": [
    "candidate",
    "basis",
    "decision"
   ],
   "properties": {
    "candidate": {
     "$ref": "#/$defs/slug"
    },
    "candidate_title": {
     "type": "string"
    },
    "basis": {
     "type": "string"
    },
    "live_address": {
     "type": [
      "string",
      "null"
     ]
    },
    "pr": {
     "type": [
      "integer",
      "null"
     ]
    },
    "conflict": {
     "type": "string"
    },
    "decision": {
     "enum": [
      "owner_to_decide",
      "proposed",
      "accepted"
     ]
    }
   },
   "additionalProperties": false
  },
  "section": {
   "enum": [
    "Wales",
    "Argentina",
    "Online"
   ],
   "description": "Primary section on the landing (the three cards)."
  },
  "sections_shown": {
   "type": "array",
   "items": {
    "enum": [
     "Wales",
     "Argentina",
     "Online"
    ]
   },
   "uniqueItems": true,
   "description": "Every section whose menu/modal lists the app (data/halves.json groups)."
  },
  "group": {
   "enum": [
    "artifacts",
    "interactive",
    "story",
    "research",
    "none"
   ]
  },
  "title": {
   "$ref": "#/$defs/i18n"
  },
  "description": {
   "type": "string"
  },
  "path": {
   "$ref": "#/$defs/path"
  },
  "aliases": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/path"
   }
  },
  "legacy_hosts": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "branch": {
   "type": "object",
   "required": [
    "name",
    "exists",
    "standard_name"
   ],
   "properties": {
    "name": {
     "type": [
      "string",
      "null"
     ],
     "description": "The cedwyn repo branch the app is built from today (null if built from main or nowhere)."
    },
    "exists": {
     "type": "boolean"
    },
    "standard_name": {
     "type": "string",
     "pattern": "^webapp/[a-z0-9-]+$",
     "description": "Standard branch name: webapp/<id>. Created when the app is migrated; until then 'name' stays the source."
    },
    "source_dir": {
     "type": [
      "string",
      "null"
     ]
    },
    "other_branches": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "front_end": {
   "type": "object",
   "required": [
    "kind",
    "hosting",
    "worker_on_read"
   ],
   "properties": {
    "kind": {
     "enum": [
      "static",
      "static_spa",
      "wordpress_mirror",
      "static_plus_dynamic",
      "none"
     ]
    },
    "hosting": {
     "enum": [
      "cloudflare_pages",
      "github_pages",
      "none"
     ]
    },
    "project": {
     "type": "string"
    },
    "build": {
     "type": "string"
    },
    "worker_on_read": {
     "type": "boolean",
     "description": "Must be false at phase static_front_end: a page view runs no Worker."
    },
    "notes": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "header": {
   "type": "object",
   "required": [
    "contract",
    "nav_source",
    "prev_next",
    "languages"
   ],
   "properties": {
    "contract": {
     "const": "cedwyn-header/1"
    },
    "nav_source": {
     "const": "/areas.json#nav"
    },
    "prev_next": {
     "type": "boolean"
    },
    "label_format": {
     "const": "{n} of 59"
    },
    "languages": {
     "type": "array",
     "items": {
      "enum": [
       "en",
       "cy",
       "es"
      ]
     },
     "minItems": 1
    },
    "scripts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "status": {
     "enum": [
      "standard",
      "legacy",
      "missing",
      "n/a"
     ]
    }
   },
   "additionalProperties": false
  },
  "data": {
   "type": "object",
   "required": [
    "slice",
    "query",
    "registers"
   ],
   "properties": {
    "slice": {
     "type": "string",
     "description": "Slice id in data/core/slices.json; output /<id>/_data/<slice>.json."
    },
    "query": {
     "type": "object",
     "required": [
      "kinds",
      "uid_prefixes"
     ],
     "properties": {
      "kinds": {
       "type": "array",
       "items": {
        "enum": [
         "evidence",
         "artifact",
         "place",
         "person_or_body",
         "event",
         "screening_lead",
         "missing_record",
         "observation",
         "testimony",
         "catalogue_candidate",
         "foi_finding",
         "correspondence"
        ]
       }
      },
      "uid_prefixes": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^[A-Z]{1,4}$"
       }
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "where": {
       "type": "string",
       "description": "Extra filter in plain words or a JSON-pointer test, e.g. 'scope.disposition = in_scope'."
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "public_only": {
       "const": true
      }
     },
     "additionalProperties": false
    },
    "registers": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "App-owned registers read beside the catalogue until they fold into data/core/records."
    },
    "catalogue_status": {
     "enum": [
      "in_catalogue",
      "partly",
      "not_yet",
      "n/a"
     ]
    }
   },
   "additionalProperties": false
  },
  "local_store": {
   "type": "object",
   "required": [
    "static",
    "client_cache"
   ],
   "properties": {
    "static": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^/"
     }
    },
    "client_cache": {
     "type": "object",
     "required": [
      "enabled"
     ],
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "store": {
       "enum": [
        "indexeddb",
        "localstorage",
        "none"
       ]
      },
      "strategy": {
       "enum": [
        "stale-while-revalidate",
        "cache-first",
        "network-first",
        "none"
       ]
      },
      "max_age_s": {
       "type": "integer",
       "minimum": 0
      },
      "revalidate_with": {
       "type": "string",
       "description": "Cheap freshness check, e.g. the slice index rev."
      },
      "pull_from": {
       "type": "string",
       "description": "Where a cold cache pulls (static, never a Worker)."
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "api": {
   "type": "object",
   "required": [
    "base",
    "outputs",
    "cors"
   ],
   "properties": {
    "base": {
     "type": "string",
     "pattern": "^/[a-z0-9-]+/api/v[0-9]+/$"
    },
    "outputs": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "path",
       "format"
      ],
      "properties": {
       "path": {
        "type": "string"
       },
       "format": {
        "enum": [
         "json",
         "jsonfeed",
         "atom",
         "rss",
         "xml",
         "csv",
         "sqlite"
        ]
       },
       "description": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    },
    "cors": {
     "const": "*"
    },
    "cache_control": {
     "type": "string"
    },
    "listed_in": {
     "const": "/api/index.json"
    }
   },
   "additionalProperties": false
  },
  "consumes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/endpoint"
   },
   "description": "Other webapps' APIs this app reads."
  },
  "consumed_by": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/slug"
   }
  },
  "external_sources": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "adapter",
     "cadence",
     "writes"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "adapter": {
      "type": "string"
     },
     "cadence": {
      "type": "string"
     },
     "auth": {
      "enum": [
       "none",
       "ci_secret",
       "box_connected_app",
       "owner_only"
      ]
     },
     "writes": {
      "type": "string",
      "pattern": "^/"
     },
     "notes": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "dynamic_endpoints": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "worker",
     "why"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "worker": {
      "type": "string"
     },
     "why": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "description": "The ONLY paths allowed to run code (writes, payments, hive job sign-ups, chat)."
  },
  "migration": {
   "type": "object",
   "required": [
    "phase",
    "phases_done",
    "rag",
    "next_action",
    "blockers"
   ],
   "properties": {
    "phase": {
     "$ref": "#/$defs/phase",
     "description": "Last phase completed."
    },
    "phases_done": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/phase"
     },
     "uniqueItems": true
    },
    "rag": {
     "enum": [
      "red",
      "amber",
      "green",
      "grey"
     ]
    },
    "next_action": {
     "type": "string"
    },
    "blockers": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "prs": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "pilot": {
     "type": "boolean"
    },
    "verified": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      },
      "at": {
       "type": "string"
      },
      "result": {
       "type": "string"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "owner": {
   "type": "string"
  },
  "version": {
   "$ref": "#/$defs/semver"
  },
  "changelog": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "version",
     "date",
     "summary"
    ],
    "properties": {
     "version": {
      "$ref": "#/$defs/semver"
     },
     "date": {
      "$ref": "#/$defs/date"
     },
     "summary": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Where each fact in this manifest was read (repo file@ref, live inventory)."
  }
 }
}